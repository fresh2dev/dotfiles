// src: https://github.com/wiraki/dotfiles/blob/main/private_dot_config/zellij/layouts/default.kdl
layout {

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="status-bar" {
                // format_left   "{mode}#[bg=#181926] {tabs}"
                // format_left   "{session} {mode} {tabs}"
                format_left   "#[bg=#8aadf4,fg=#181926,bold]  {session}#[fg=#8aadf4] {tabs}"
                format_center "{pipe_fzj_statusline}"
                // format_right  "{notifications} #[fg=#494d64,bold]{mode}"
                format_right  "#[fg=#494d64,bold]{mode}"
                // format_space  "#[bg=#181926]"
                // format_space  "#[bg=#000]"
                format_hide_on_overlength "true"
                format_precedence "lrc"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#6C7086]{char}"
                border_position "top"

                // hide_frame_for_single_pane "true"  // Handled by `zjframes`

                // In Normal-mode, display nothing
                mode_normal        ""
                // In Locked-mode, display only lock glyph
                mode_locked        "#[fg=#8aadf4]  "
                // In other modes, display the mode name
                mode_resize        "#[fg=#8aadf4] [RESIZE]"
                mode_pane          "#[fg=#8aadf4] [PANE]"
                mode_tab           "#[fg=#8aadf4] [TAB]"
                mode_scroll        "#[fg=#8aadf4] [SCROLL]"
                mode_enter_search  "#[fg=#8aadf4] [ENT-SEARCH]"
                mode_search        "#[fg=#8aadf4] [SEARCHARCH]"
                mode_rename_tab    "#[fg=#8aadf4] [RENAME-TAB]"
                mode_rename_pane   "#[fg=#8aadf4] [RENAME-PANE]"
                mode_session       "#[fg=#8aadf4] [SESSION]"
                mode_move          "#[fg=#8aadf4] [MOVE]"
                mode_prompt        "#[fg=#8aadf4] [PROMPT]"
                mode_tmux          "#[fg=#8aadf4] [TMUX]"

                // formatting for inactive tabs
                tab_active              "#[fg=#a6da95]#[bg=#a6da95,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#a6da95,bold] {name}{floating_indicator}#[fg=#363a4f,bold]"
                tab_active_fullscreen   "#[fg=#a6da95]#[bg=#a6da95,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#a6da95,bold] {name}{fullscreen_indicator}#[fg=#363a4f,bold]"
                tab_active_sync         "#[fg=#a6da95]#[bg=#a6da95,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#a6da95,bold] {name}{sync_indicator}#[fg=#363a4f,bold]"

                // formatting for the current active tab
                tab_normal              "#[fg=#6e738d]#[bg=#6e738d,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#6e738d,bold] {name}{floating_indicator}#[fg=#363a4f,bold]"
                tab_normal_fullscreen   "#[fg=#6e738d]#[bg=#6e738d,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#6e738d,bold] {name}{fullscreen_indicator}#[fg=#363a4f,bold]"
                tab_normal_sync         "#[fg=#6e738d]#[bg=#6e738d,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#6e738d,bold] {name}{sync_indicator}#[fg=#363a4f,bold]"

                // separator between the tabs
                // tab_separator           "#[bg=#181926] "
                tab_separator           " "

                // indicators
                tab_sync_indicator       " "
                tab_fullscreen_indicator " 󰊓"
                tab_floating_indicator   " 󰹙"

                // command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                // command_git_branch_format      "#[fg=blue] {stdout} "
                // command_git_branch_interval    "10"
                // command_git_branch_rendermode  "static"

                // notification_format_unread           "#[fg=#89B4FA,bg=#181825,blink]  #[fg=#89B4FA,bg=#181825] {message} "
                // notification_format_no_notifications "#[fg=#89B4FA,bg=#181825,dim]   "
                // notification_show_interval           "5"

                pipe_fzj_statusline_format     "{output}"
                pipe_fzj_statusline_rendermode "raw"

                // datetime        "#[fg=#6C7086,bold] {format} "
                // datetime_format "%A, %d %b %Y %H:%M"
                // datetime_timezone "Europe/Berlin"
            }
        }
        children
    }

    swap_tiled_layout name="vertical" {
        tab max_panes=5 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        tab max_panes=8 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
            }
        }
        tab max_panes=12 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
                pane { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="horizontal" {
        tab max_panes=5 {
            pane
            pane
        }
        tab max_panes=8 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
        tab max_panes=12 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="stacked" {
        tab min_panes=5 {
            pane split_direction="vertical" {
                pane
                pane stacked=true { children; }
            }
        }
    }

    swap_floating_layout name="staggered" {
        floating_panes
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane { x "5%"; y 1; width "90%"; height "90%"; }
            pane { x "5%"; y 2; width "90%"; height "90%"; }
            pane { x "5%"; y 3; width "90%"; height "90%"; }
            pane { x "5%"; y 4; width "90%"; height "90%"; }
            pane { x "5%"; y 5; width "90%"; height "90%"; }
            pane { x "5%"; y 6; width "90%"; height "90%"; }
            pane { x "5%"; y 7; width "90%"; height "90%"; }
            pane { x "5%"; y 8; width "90%"; height "90%"; }
            pane { x "5%"; y 9; width "90%"; height "90%"; }
            pane focus=true { x 10; y 10; width "90%"; height "90%"; }
        }
    }

    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane {y "50%"; x "50%"; }
        }
        floating_panes max_panes=2 {
            pane { x "1%"; y "25%"; width "45%"; }
            pane { x "50%"; y "25%"; width "45%"; }
        }
        floating_panes max_panes=3 {
            pane focus=true { y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; }
            pane { x "50%"; y "1%"; width "45%"; }
        }
        floating_panes max_panes=4 {
            pane { x "1%"; y "55%"; width "45%"; height "45%"; }
            pane focus=true { x "50%"; y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; height "45%"; }
            pane { x "50%"; y "1%"; width "45%"; height "45%"; }
        }
    }
}
