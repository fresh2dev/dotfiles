// Based on default.kdl: a `cld` pane docked left at 30% width, `nvim` and new panes to its right.
layout {

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
        children
    }

    tab focus=true {
        pane split_direction="vertical" {
            pane size="30%" command="zsh" {
                args "-ic" "cld"
            }
            pane command="nvim" focus=true {
                // args "+lua Snacks.lazygit()"
            }
        }
    }

    // `cld` stays left at 30%, full height; `nvim` is top right. The first new pane goes
    // below `nvim`, and each one after that splits that bottom row vertically.
    swap_tiled_layout name="agentic" {
        tab {
            pane split_direction="vertical" {
                pane size="30%"
                pane {
                    pane
                    pane size="40%" split_direction="vertical" { children; }
                }
            }
        }
    }
}
