# off | check | download
auto-update = off
# stable | tip
auto-update-channel = stable

cursor-invert-fg-bg = true

# Font
font-size = 14
font-family = MesloLGL Nerd Font
font-thicken = true

window-title-font-family = iMWritingQuat Nerd Font

window-inherit-working-directory = false
window-inherit-font-size = false

cursor-style = bar
cursor-style-blink = false
cursor-click-to-move = false
mouse-hide-while-typing = true

# Theme
# https://iterm2colorschemes.com
theme = Carbonfox

unfocused-split-opacity = 0.98

clipboard-write = allow
clipboard-read  = allow

# Disable all built-in keybindings
keybind = clear

#keybind = alt+e=write_screen_file:paste
#keybind = super+left_bracket=goto_split:previous
keybind = super+n=new_window
#keybind = super+right_bracket=goto_split:next
keybind = super+comma=open_config
keybind = super+up=jump_to_prompt:1
