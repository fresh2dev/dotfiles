# keybind = alt+grave_accent=new_split:down
# keybind = alt+h=goto_split:left
# keybind = alt+i=inspector:toggle
# keybind = alt+j=goto_split:down
# keybind = alt+k=goto_split:up
# keybind = alt+l=goto_split:right
keybind = super+h=esc:b
# keybind = alt+left_bracket=previous_tab
# keybind = alt+left_bracket=previous_tab
# keybind = alt+m=toggle_split_zoom
# keybind = alt+n=new_split:right
keybind = super+physical:eight=goto_tab:8
keybind = super+physical:five=goto_tab:5
keybind = super+physical:four=goto_tab:4
keybind = super+physical:one=goto_tab:1
keybind = super+physical:seven=goto_tab:7
keybind = super+physical:six=goto_tab:6
keybind = super+physical:three=goto_tab:3
keybind = super+physical:two=goto_tab:2
keybind = super+w=close_surface
keybind = super+q=quit
# keybind = super+w=close_all_windows
# keybind = super+w=close_tab
# keybind = alt+shift+down=resize_split:down,100
# keybind = alt+shift+left=resize_split:left,100
