      // "x": "git::ToggleStaged",
      // "shift-x": "git::StageAll",
      // "g x": "git::StageRange",
      // "shift-u": "git::UnstageAll",
      "i": null, // DISABLED
      "x": null, // DISABLED
      "-": "git::ToggleStaged",
      "+": "git::StageAll",
      "_": "git::UnstageAll",
      "c": "git_panel::FocusEditor",
      // NOTE: This is "stage all" by default,
      // but is overridden to reset a file!
      // (as is done in `tpope/vim-fugitive`)
      "shift-x": "git::RestoreFile",
      "shift-i": "git::AddToGitignore",
      "space": null, // DISABLED
      // nav
      "ctrl-j": "git_panel::FocusEditor",
      "ctrl-w ctrl-j": "git_panel::FocusEditor",
      "ctrl-w j": "git_panel::FocusEditor",
    },
  },
  {
    "context": "GitPanel > Editor",
    "use_key_equivalents": true,
    "bindings": {
      // nav
      "ctrl-k": "git_panel::FocusChanges",
      "ctrl-w ctrl-k": "git_panel::FocusChanges",
      "ctrl-w k": "git_panel::FocusChanges",
    },
  },
  {
    "context": "GitDiff > Editor",
    "use_key_equivalents": true,
    "bindings": {
      "-": ["action::Sequence", ["git::ToggleStaged", "editor::GoToHunk"]],
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      // "ctrl-h": "editor::Backspace",
      // "ctrl-u": "editor::DeleteToBeginningOfLine",
      // "ctrl-w": "editor::DeleteToPreviousWordStart"
      "ctrl-h": null, // DISABLED
      "ctrl-u": null, // DISABLED
      "ctrl-w": null, // DISABLED
      "ctrl-n": "editor::MoveDown",
      "ctrl-p": "editor::MoveUp",
      "ctrl-y": "menu::Confirm",
    },
  },
