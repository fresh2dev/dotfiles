    "context": "FileFinder",
    "bindings": {
      "ctrl-v": "pane::SplitRight",
      "ctrl-shift-v": "pane::SplitLeft",
      "ctrl-o": "pane::SplitDown",
      "ctrl-shift-o": "pane::SplitUp",
