// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // "context": "EmptyPane || SharedScreen || Dock || Pane || Editor",
    // "context": "!Terminal",
    "bindings": {
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-l": "workspace::ActivatePaneRight",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-shift-l": "workspace::ActivateNextWindow",
      "alt-shift-h": "workspace::ActivatePreviousWindow",
      "alt-space": "terminal_panel::Toggle",
      "alt-\\": "workspace::ToggleRightDock",
      "alt-|": "multi_workspace::ToggleWorkspaceSidebar",
    },
  },
  {
    // "context": "(EmptyPane || SharedScreen || Dock || Pane || Editor) && !Terminal",
    "context": "!Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-w": null,
      "ctrl-w left": "workspace::ActivatePaneLeft",
      "ctrl-w right": "workspace::ActivatePaneRight",
      "ctrl-w up": "workspace::ActivatePaneUp",
      "ctrl-w down": "workspace::ActivatePaneDown",
      "ctrl-w ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-w ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-w ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-w ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w w": "workspace::ActivateNextPane",
      "ctrl-w ctrl-w": "workspace::ActivateNextPane",
      "ctrl-w p": "workspace::ActivatePreviousPane",
      "ctrl-w ctrl-p": "workspace::ActivatePreviousPane",
      "ctrl-w shift-w": "workspace::ActivatePreviousPane",
      "ctrl-w ctrl-shift-w": "workspace::ActivatePreviousPane",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-n": "pane::SplitRight",
      "alt-v": "pane::SplitRight",
      "alt-t": "workspace::NewTerminal",
      "alt-m": "workspace::ToggleZoom",
      "alt-w": [
        "pane::CloseActiveItem",
        {
          "save_intent": "skip",
        },
      ],
      "shift-up": ["terminal::SendKeystroke", "shift-up"],
      "shift-down": ["terminal::SendKeystroke", "shift-down"],
    },
  },
  {
    "context": "Dock && !Terminal",
    "bindings": {
      "ctrl-w q": "workspace::CloseActiveDock",
      "ctrl-w c": "workspace::CloseActiveDock",
      "ctrl-w ctrl-q": "workspace::CloseActiveDock",
      "ctrl-w ctrl-c": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Pane && !Terminal",
    "bindings": {
      "ctrl-w q": "pane::CloseActiveItem",
      "ctrl-w c": "pane::CloseActiveItem",
      "ctrl-w ctrl-q": "pane::CloseActiveItem",
      "ctrl-w ctrl-c": "pane::CloseActiveItem",
    },
  },
  {
    // "context": "ThreadsSidebar || Editor || EmptyPane",
    "bindings": {
      "alt-shift-[": "multi_workspace::PreviousThread",
      "alt-shift-]": "multi_workspace::NextThread",
      // "alt-tab": "agents_sidebar::ToggleThreadSwitcher",
      // "alt-shift-up": "multi_workspace::MoveProjectUp",
      // "alt-shift-down": "multi_workspace::MoveProjectDown",
      // "alt-shift-enter": "multi_workspace::MoveProjectToNewWindow",
    },
  },
  {
    "context": "Dock && !Terminal && !Editor",
    "bindings": {
      "\\": "workspace::CloseActiveDock",
      "|": "workspace::CloseActiveDock",
      "q": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Pane && !Terminal && !Editor",
    "bindings": {
      "\\": "vim::ToggleProjectPanelFocus",
      "|": "vim::ToggleProjectPanelFocus",
      "q": "pane::CloseActiveItem",
    },
  },
  {
    "context": "menu",
    "bindings": {
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious",
      "ctrl-y": "menu::Confirm",
    },
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      // "ctrl-e": "vim::LineDown",
      // "ctrl-y": "vim::LineUp"
      "ctrl-d": null, // DISABLED
      "ctrl-u": null, // DISABLED
      "ctrl-e": null, // DISABLED
      "ctrl-y": "editor::ComposeCompletion",
      "ctrl-n": "editor::ContextMenuNext",
      "ctrl-p": "editor::ContextMenuPrevious",
      "ctrl-g": "editor::ContextMenuFirst",
      "ctrl-shift-g": "editor::ContextMenuLast",
      // Restore default behavior of `enter` and `tab`
      "enter": ["action::Sequence", ["editor::Cancel", "editor::Newline"]],
      "tab": ["action::Sequence", ["editor::Cancel", "editor::Tab"]],
    },
  },
  {
    "context": "Editor && showing_completions",
    "use_key_equivalents": true,
    "bindings": {
      // "enter": "editor::ConfirmCodeAction"
      "ctrl-y": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "Editor && showing_code_actions",
    "use_key_equivalents": true,
    "bindings": {
      // "enter": "editor::ConfirmCodeAction"
      "ctrl-y": "editor::ConfirmCodeAction",
    },
  },
  // Empty pane, set of keybindings that are available when there is no active editor
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      // File finder
      "space f f": "file_finder::Toggle",
      // File search grep
      "space f s": "pane::DeploySearch",
      // Open recent project
      "space f o": "projects::OpenRecent",
      "space g g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "VimControl",
    "bindings": {
      // Workaround for files not reflecting changes made outside of Zed
      // ref: https://github.com/zed-industries/zed/issues/38109
      "space 5": "editor::ReloadFile",
      // These bindings are are applicable to the context menu.
      "g d": "editor::GoToDefinition",
      "g shift-d": "editor::GoToDeclaration",
      "g y": "editor::GoToTypeDefinition",
      "g shift-i": "editor::GoToImplementation",
      "g r i": "editor::GoToImplementation",
      "g r r": "editor::FindAllReferences",
      "g r a": "editor::ToggleCodeActions",
      "g r n": "editor::Rename",
    },
  },
