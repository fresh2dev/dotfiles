      // "space t p": "pane::TogglePinTab",
      // GIT
      // TODO: note about requiring lazygit in tasks.json
      // TODO: add more (gd, gD, lg, ga, gs, gx)
      // "space g h d": "editor::ToggleSelectedDiffHunks",
      "space l g": [
        "task::Spawn",
        {
          "task_name": "Start LazyGit",
          "reveal_target": "center",
        },
      ],
      "space g h": [
        "task::Spawn",
        {
          "task_name": "Start LazyGit file history",
          "reveal_target": "center",
        },
      ],
      "space g g": "git_panel::ToggleFocus",
      "space g a": "git::ToggleStaged",
      "space g r": "git::Restore",
      "space g b": "editor::ToggleGitBlameInline",
      "space g shift-b": "git::Blame",
      "space g p": "git::Push",
      "space g P": "git::ForcePush",
      "space g d": "git::Diff",
      "space g D": "git::DiffBranch",
      "space g c": "git::ExpandCommitEditor",
      // File finder
      "space f f": "file_finder::Toggle",
      // File search grep
      "space f s": "pane::DeploySearch",
      // Open recent project
      "space f o": "projects::OpenRecent",
      // Find diagnostics
      "space f d": "diagnostics::Deploy",
      // Find marks
      "space f m": "vim::ToggleMarksView",
      // Find registers
      "space f r": "vim::ToggleRegistersView",
      // Find buffers
      "space f b": "tab_switcher::ToggleAll",
      "g b": "tab_switcher::ToggleAll",
      // Open new file / tab
      "space N": "workspace::NewFile",
      // Focus terminal
      "space `": "terminal_panel::ToggleFocus",
      // Show project panel with current file
      // "\\": "vim::ToggleProjectPanelFocus",
      "\\": "vim::ToggleProjectPanelFocus",
      "|": "pane::RevealInProjectPanel",
      "space m p": "markdown::OpenFollowingPreview",
      "space m \\": "editor::ToggleMinimap",
      // SAVE / CLOSE
      "space w": [
        "workspace::Save",
        {
          "save_intent": "save_all",
        },
      ],
      "space shift-w": [
        "workspace::SaveAll",
        {
          "save_intent": "save_all",
        },
      ],
      "space q q": [
        "pane::CloseActiveItem",
        {
          "save_intent": "close",
        },
      ],
      "space q a": [
        "pane::CloseAllItems",
        {
          "save_intent": "close",
        },
      ],
      "space q o": [
        "pane::CloseOtherItems",
        {
          "save_intent": "close",
        },
      ],
      "space shift-q": [
        "pane::CloseActiveItem",
        {
          "save_intent": "skip",
        },
      ],
      "space x": [
        "pane::CloseActiveItem",
        {
          "save_intent": "save_all",
        },
      ],
      "space shift-x": [
        "pane::CloseOtherItems",
        {
          "save_intent": "save_all",
        },
      ],
    },
