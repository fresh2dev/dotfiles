# EditorConfig is awesome: https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = true

[*.{sh,json,yaml,yml,toml,html,js,lua}]
indent_size = 2

[.{profile,bash_profile,zprofile,bashrc,zshrc,zshenv}]
indent_size = 2

[*.vimrc]
indent_size = 2

[*.py]
max_line_length = 88

# Makefiles always use tabs for indentation
[Makefile]
indent_style = tab

# Minified JavaScript files shouldn't be changed
[**.min.js]
indent_style = ignore
insert_final_newline = ignore
