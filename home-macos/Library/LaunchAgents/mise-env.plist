<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Publish the `[env]` table from ~/.config/mise/config.toml to launchd, so GUI
  apps not started from a terminal see the same XDG_*, EDITOR, ... values as a
  shell. PATH is skipped.

  Load once:   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/mise-env.plist
  Re-run:      launchctl kickstart -k gui/$(id -u)/mise-env

  Only processes launched afterwards see the values; relaunch open apps.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>mise-env</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string><![CDATA[
MISE_CONFIG_DIR="${HOME}/.config/mise" "${HOME}/.local/bin/mise" env ls --dotenv \
  | while IFS='=' read -r name value; do
      launchctl setenv "$name" "$value"
    done
]]></string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardErrorPath</key>
  <string>/tmp/mise-env.log</string>
</dict>
</plist>
