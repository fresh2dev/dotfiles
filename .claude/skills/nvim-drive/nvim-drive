#!/usr/bin/env bash
# Start and drive a Neovim instance over RPC. See SKILL.md for usage.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
name=${NVIM_DRIVE_NAME:-main}
dir=${TMPDIR:-/tmp}/nvim-drive
sock=$dir/$name.sock
session=nvim-drive-$name
size=${NVIM_DRIVE_SIZE:-50x160}

# Never act on the caller's own zellij session.
unset ZELLIJ ZELLIJ_SESSION_NAME ZELLIJ_PANE_ID

die() {
  echo "nvim-drive: $*" >&2
  exit 1
}

usage() {
  cat <<EOF
usage: nvim-drive start [--ui] [--cwd DIR] [-- NVIM_ARGS...]
       nvim-drive lua FILE | -e CODE | -     run Lua, print its return value as JSON
       nvim-drive keys KEYS                   send keys (nvim --remote-send syntax)
       nvim-drive screen [--ansi]             print the UI instance's screen
       nvim-drive stop
       nvim-drive status
env:   NVIM_DRIVE_NAME (default: main) names the instance; socket: $dir/<name>.sock
       NVIM_DRIVE_SIZE (default: 50x160) is the --ui screen as ROWSxCOLS
EOF
}

running() {
  [[ -S $sock ]] && nvim --server "$sock" --remote-expr 1 >/dev/null 2>&1
}

start() {
  local ui=0 cwd=$PWD
  while (($#)); do
    case $1 in
      --ui) ui=1 ;;
      --cwd)
        cwd=$(cd "$2" && pwd)
        shift
        ;;
      --)
        shift
        break
        ;;
      *) break ;;
    esac
    shift
  done
  running && die "already running: $sock (stop it, or set NVIM_DRIVE_NAME)"
  mkdir -p "$dir"
  rm -f "$sock"

  # Run with the tools and virtualenv a shell in $cwd would have, not the
  # caller's: an inherited VIRTUAL_ENV makes Python servers resolve the wrong
  # site-packages, and an inherited PATH can hold stale tool versions.
  local path=$PATH
  if [[ -n ${VIRTUAL_ENV:-} ]]; then
    path=$(tr : '\n' <<<"$path" | grep -vxF "$VIRTUAL_ENV/bin" | paste -sd: -)
  fi
  if command -v mise >/dev/null; then
    path=$(cd "$cwd" && PATH=$path mise env -q -C "$cwd" --json 2>/dev/null |
      jq -r '.PATH // empty') || true
    [[ -n $path ]] || path=$PATH
  fi
  local envv=(env -u VIRTUAL_ENV "PATH=$path")
  if [[ -x $cwd/.venv/bin/python ]]; then
    envv=(env "VIRTUAL_ENV=$cwd/.venv" "PATH=$cwd/.venv/bin:$path")
  fi

  if ((ui)); then
    (cd "$cwd" && zellij --layout-string 'layout { pane; }' attach \
      --create-background "$session" -- "${envv[@]}" nvim --listen "$sock" "$@")
    # A session with no client is stuck at 50x50, so attach a hidden client
    # with a pty of the wanted size. It exits when the session is killed.
    (nohup script -q /dev/null sh -c \
      "stty rows ${size%x*} cols ${size#*x}; exec zellij attach '$session'" \
      >/dev/null 2>&1 </dev/null &)
  else
    (cd "$cwd" && nohup "${envv[@]}" nvim --headless --listen "$sock" "$@" \
      >"$dir/$name.log" 2>&1 &)
  fi
  for _ in $(seq 100); do
    running && {
      echo "$sock"
      return
    }
    sleep 0.1
  done
  die "nvim did not start; see $dir/$name.log"
}

lua_cmd() {
  running || die "not running: $sock"
  local file
  case ${1:--} in
    -e)
      file=$(mktemp "$dir/XXXXXX")
      printf '%s\n' "$2" >"$file"
      ;;
    -)
      file=$(mktemp "$dir/XXXXXX")
      cat >"$file"
      ;;
    *) file=$(cd "$(dirname "$1")" && pwd)/$(basename "$1") ;;
  esac
  # shortcut: paths containing a single quote break this expression; quote them
  # if that ever matters.
  nvim --server "$sock" --remote-expr \
    "luaeval('dofile(_A[1]).run(_A[2])', ['$here/lib.lua', '$file'])"
  echo
}

stop() {
  if running; then
    nvim --server "$sock" --remote-send '<C-\><C-n>:qa!<CR>' 2>/dev/null || true
  fi
  if zellij list-sessions -n 2>/dev/null | grep -q "^$session "; then
    zellij kill-session "$session" >/dev/null 2>&1 || true
    zellij delete-session "$session" >/dev/null 2>&1 || true
  fi
  rm -f "$sock"
}

case ${1:-} in
  start)
    shift
    start "$@"
    ;;
  lua)
    shift
    lua_cmd "$@"
    ;;
  keys)
    running || die "not running: $sock"
    nvim --server "$sock" --remote-send "$2"
    ;;
  screen)
    # nvim is the session's first and only terminal pane.
    zellij -s "$session" action dump-screen -p terminal_0 ${2:+"$2"} 2>/dev/null ||
      die "no UI session $session (start with --ui)"
    ;;
  stop) stop ;;
  status) running && echo "running: $sock" || echo "stopped" ;;
  *) usage ;;
esac
